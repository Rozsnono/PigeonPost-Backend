# Másold .env.local néven és töltsd ki. Valódi értékeket SOHA ne commitolj.
MONGODB_URI=mongodb://localhost:27017/pigeonpost
JWT_SECRET=change-me-long-random-string
ADMIN_SECRET=change-me-long-random-string
CRON_SECRET=change-me-long-random-string
NEXT_PUBLIC_MAP_USER_AGENT=PigeonPost/1.0
# Jelszó-visszaállító email (SMTP) – nélküle az elfelejtett jelszó kód nem megy ki
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=PigeonPost <noreply@example.com>
# Opcionális
# JWT_ACCESS_TTL=7d
# REFRESH_TTL_DAYS=90
# CORS_ALLOW_ORIGIN=*
# DISABLE_INTERNAL_FLIGHT_RUNNER=true
